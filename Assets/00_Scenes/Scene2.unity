  m_Script: {fileID: 11500000, guid: 600358e0a70e11c45a249661d40ef600, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizGame
  questions:
  - text: "\uB9E4\uC6B4 \uC74C\uC2DD\uC744 \uBA39\uC5C8\uC744 \uB54C\uB294\n\uBB3C\uBCF4\uB2E4
      \uC6B0\uC720\uAC00 \uB9E4\uC6B4\uB9DB\uC744 \uB354 \uC798 \uAC00\uB77C\uC549\uD78C\uB2E4."
    answer: 1
    explain: "\uB9E4\uC6B4\uB9DB \uC131\uBD84\uC740 \uBB3C\uC5D0 \uC798 \uC548 \uB179\uACE0\n\uC6B0\uC720\uC758
      \uC9C0\uBC29\uACFC \uB2E8\uBC31\uC9C8\uC774 \uB3C4\uC6C0\uC744 \uC918\uC694."
  - text: "\uC57D\uC740 \uC815\uD574\uC9C4 \uC591\uBCF4\uB2E4 \uB9CE\uC774 \uBA39\uC5B4\uB3C4\n\uB354
      \uBE68\uB9AC \uB0AB\uB294\uB2E4."
    answer: 0
    explain: "\uC57D\uC740 \uC815\uD574\uC9C4 \uC591\uACFC \uC2DC\uAC04\uC744 \uC9C0\uCF1C\uC57C
      \uD574\uC694.\n\uB9CE\uC774 \uBA39\uC73C\uBA74 \uC624\uD788\uB824 \uC704\uD5D8\uD574\uC694!"
  - text: "\uD574\uBB3C\uD30C\uC804\uC740 \uBC00\uAC00\uB8E8 \uBC18\uC8FD\uC5D0\n\uCABD\uD30C\uC640
      \uD574\uBB3C\uC744 \uB123\uC5B4 \uBD80\uCE5C \uC74C\uC2DD\uC774\uB2E4."
    answer: 1
    explain: "\uBC14\uC0AD\uD558\uAC8C \uBD80\uCE5C \uD30C\uC804\uC740\n\uB9C9\uAC78\uB9AC\uC640\uB3C4
      \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uBA39\uC790\uACE8\uBAA9 \uB300\uD45C \uBA54\uB274\uC608\uC694."
  passMark: 2
